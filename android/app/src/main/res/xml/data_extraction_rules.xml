<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Keep credentials out of both cloud backup and device-to-device transfer:
     the encryption key lives in the AndroidKeyStore and is never transferred, so a restored
     copy could not be read anyway, and shipping it serves no purpose. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
