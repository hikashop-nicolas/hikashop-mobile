{
	"name": "hikashop-mobile",
	"private": true,
	"version": "0.0.0",
	"description": "Manage a HikaShop store from a phone, a tablet or a browser.",
	"license": "GPL-3.0-or-later",
	"homepage": "https://www.hikashop.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hikashop-nicolas/hikashop-mobile.git"
	},
	"bugs": {
		"url": "https://github.com/hikashop-nicolas/hikashop-mobile/issues"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.app.json",
		"sync": "cap sync",
		"build:app": "npm run build && cap sync",
		"cypress": "cypress open",
		"e2e": "cypress run",
		"screenshots": "cypress run --config specPattern=cypress/docs/**/*.cy.ts,screenshotsFolder=docs/screenshots && node tools/flatten-screenshots.mjs",
		"a11y": "cypress run --config specPattern=cypress/a11y/**/*.cy.ts",
		"hooks": "git config core.hooksPath .githooks"
	},
	"dependencies": {
		"@aparajita/capacitor-secure-storage": "^7.1.6",
		"@capacitor/android": "^7.6.8",
		"@capacitor/app": "^7.1.2",
		"@capacitor/core": "^7.6.8",
		"@capacitor/status-bar": "^7.0.6",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router-dom": "^7.18.1"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.6.8",
		"@guidepup/virtual-screen-reader": "^0.32.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"axe-core": "^4.13.0",
		"cypress": "^15.20.0",
		"jsdom": "^29.1.1",
		"oxlint": "^1.71.0",
		"typescript": "~6.0.2",
		"vite": "^8.1.1",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10"
	}
}
