		"cypress": "cypress open",
		"e2e": "cypress run"
	},
	"dependencies": {
		"@aparajita/capacitor-secure-storage": "^7.1.6",
		"@capacitor/android": "^7.6.8",
		"@capacitor/app": "^7.1.2",
		"@capacitor/core": "^7.6.8",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router-dom": "^7.18.1"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.6.8",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"cypress": "^15.20.0",
		"jsdom": "^29.1.1",
		"oxlint": "^1.71.0",
		"typescript": "~6.0.2",
		"vite": "^8.1.1",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10"
